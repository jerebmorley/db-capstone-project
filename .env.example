# Copiá este archivo a .env y completá tus valores reales.
# .env está en .gitignore: nunca lo subas al repo.

# Conexión de los scripts de scripts/. Docker crea este usuario al levantar MySQL.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=little_lemon_restaurante

# Solo para docker-compose: contraseña de root dentro del contenedor.
MYSQL_ROOT_PASSWORD=tu_root_password

# Warehouse PostgreSQL. Docker crea este usuario como dueño de la base.
PG_HOST=127.0.0.1
PG_PORT=5434
PG_DB=little_lemon_dw
PG_USER=tu_usuario_pg
PG_PASSWORD=tu_password_pg

# Airflow (docker compose --profile airflow). Usuario de la interfaz web en
# http://localhost:AIRFLOW_PORT, contraseña de su base de metadatos y secreto
# que firma sus tokens (generalo con: openssl rand -hex 32).
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=tu_usuario_airflow
AIRFLOW_ADMIN_PASSWORD=tu_password_airflow
AIRFLOW_DB_PASSWORD=tu_password_airflow_db
AIRFLOW_JWT_SECRET=cambiame_por_un_valor_aleatorio
